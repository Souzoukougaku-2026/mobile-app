<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 1. 背景の暗幕 -->
    <View android:id="@+id/exo_controls_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#4D000000"/>

    <!-- 2. 中央ボタン -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal">

        <ImageButton android:id="@+id/exo_rew"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@android:color/transparent"
            android:src="@drawable/exo_styled_controls_rewind"
            android:scaleType="fitCenter"
            android:contentDescription="Rewind"/>

        <ImageButton android:id="@+id/exo_play_pause"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@android:color/transparent"
            android:src="@drawable/exo_styled_controls_play"
            android:scaleType="fitCenter"
            android:contentDescription="Play/Pause"/>

        <ImageButton android:id="@+id/exo_ffwd"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@android:color/transparent"
            android:src="@drawable/exo_styled_controls_fastforward"
            android:scaleType="fitCenter"
            android:contentDescription="Fast Forward"/>
    </LinearLayout>

    <!-- 3. 下部バー -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#B3000000"
        android:orientation="vertical"
        android:padding="4dp">

        <androidx.media3.ui.DefaultTimeBar
            android:id="@+id/exo_progress"
            android:layout_width="match_parent"
            android:layout_height="28dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <TextView android:id="@+id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="14sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="/"
                android:textColor="#CCFFFFFF"
                android:paddingHorizontal="4dp"/>

            <TextView android:id="@+id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="14sp"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <!-- 💡 速度切り替えボタン -->
            <ImageButton android:id="@+id/exo_settings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@drawable/exo_styled_controls_speed"
                android:contentDescription="Playback Speed"/>

            <!-- 💡 フルスクリーンボタン -->
            <ImageButton android:id="@+id/exo_fullscreen"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@drawable/exo_styled_controls_fullscreen_enter"
                android:contentDescription="Fullscreen"/>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>